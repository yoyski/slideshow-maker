# Copy to .env and fill in. Never commit .env.
APP_ENV=development          # use "production" when live
SECRET_KEY=change-me         # production: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=                 # long random string; lets you call /api/admin/stats. Leave empty to turn it off
TRUSTED_PROXIES=             # set to 1 when behind a host's proxy (Render, Railway, Fly, nginx)
# DATABASE_PATH=/data/users.db   # point at a persistent disk in production
